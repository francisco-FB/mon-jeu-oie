body {
  font-family: Arial, sans-serif;
  background: #f5ecd7;
  color: #3b2a1a;
  margin: 0;
  padding: 16px;
  text-align: center;
}

h1 { color: #a8321f; }

button {
  background: #a8321f;
  color: white;
  border: none;
  border-radius: 6px;
  padding: 10px 18px;
  font-size: 16px;
  cursor: pointer;
  margin: 4px;
}
button:hover { background: #7f2415; }
button:disabled { background: #aaa; cursor: not-allowed; }

input { font-size: 16px; padding: 6px; width: 60px; }
.cache { display: none; }
#erreur { color: #a8321f; }

/* Mise en page du jeu */
#ecran-jeu {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  justify-content: center;
  align-items: flex-start;
}
#ecran-jeu.cache { display: none; }

#depart-zone {
  width: 100%;
  min-height: 34px;
  background: #d9c9a3;
  border-radius: 8px;
  padding: 4px;
  box-sizing: border-box;
}

/* Plateau : 9 colonnes x 7 lignes = 63 cases */
#plateau {
  display: grid;
  grid-template-columns: repeat(9, 64px);
  gap: 4px;
}

.case {
  width: 64px;
  height: 64px;
  background: #fffaf0;
  border: 2px solid #c9b68a;
  border-radius: 6px;
  font-size: 11px;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 2px;
  box-sizing: border-box;
}
.case .num { font-weight: bold; }
.case .icone { font-size: 16px; }
.case.oie { background: #e4f2d4; }
.case.piege { background: #f6d4cf; }
.case.pont { background: #d4e6f6; }
.case.carte { background: #f9e8a8; }
.case.arrivee { background: #ffd54a; }

.pions {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1px;
}
.pion {
  display: inline-block;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  border: 2px solid #333;
  color: white;
  font-size: 9px;
  line-height: 16px;
  font-weight: bold;
}

/* Panneau de droite */
#panneau {
  width: 280px;
  background: #fffaf0;
  border: 2px solid #c9b68a;
  border-radius: 8px;
  padding: 10px;
}
#de { font-size: 48px; }
#liste-equipes { list-style: none; padding: 0; text-align: left; }
#liste-equipes li { margin: 3px 0; }
#journal {
  height: 160px;
  overflow-y: auto;
  text-align: left;
  font-size: 13px;
  background: white;
  border: 1px solid #c9b68a;
  padding: 4px;
}
#cartes button { background: #d98f00; font-size: 13px; padding: 6px 10px; }
